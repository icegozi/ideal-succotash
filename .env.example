# Compose project and published localhost ports
COMPOSE_PROJECT_NAME=medstock
APP_IMAGE=medstock-web:local
APP_PORT=3000
ORACLE_PORT=1521

# Pinned Oracle Free image for local development and integration tests
ORACLE_IMAGE=gvenzl/oracle-free:23.26.3-slim-faststart

# Compose mounts these files as Docker secrets. Create both before use.
ORACLE_SYS_PASSWORD_FILE=./.secrets/oracle_sys_password
ORACLE_APP_PASSWORD_FILE=./.secrets/oracle_app_password
ORACLE_USER=THUOC_APP

# Baseline SQL directory on the host. It must contain 01, 03 and 05.
ORACLE_SCHEMA_DIR=./database/original
LOAD_DEMO_DATA=false

# Only enable once when adopting a pre-existing, fully validated schema.
MIGRATION_BASELINE_EXISTING=false

# Application connection settings for `npm run dev` outside Docker.
# Compose overrides the connect string and reads the password from a secret file.
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MAX=8

# Development-only identity shim. It is never accepted as production auth.
DEV_AUTH_BYPASS=true
DEV_OPERATOR_NAME=Duoc si phat trien
