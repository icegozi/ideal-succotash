# Oracle thin-mode connection. Required in production.
ORACLE_USER=THUOC_APP
ORACLE_PASSWORD=change-me
ORACLE_CONNECT_STRING=oracle-host:1521/FREEPDB1
ORACLE_POOL_MAX=8

# Development-only identity shim. It is ignored as an authentication solution in production.
DEV_AUTH_BYPASS=true
DEV_OPERATOR_NAME=Duoc si phat trien
